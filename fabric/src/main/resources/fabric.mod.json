{
  "schemaVersion": 1,
  "id": "mcservertest",
  "version": "${version}",
  "name": "MC Server Test",
  "description": "A simple mod which will stop a minecraft server after x seconds to produce an exit code of 0 for testing mods with GitHub actions.",
  "authors": [
    "JensenJ - Developer"
  ],
  "contact": {
    "sources": "https://github.com/JensenJ-Modding/MC-Server-Test",
    "issues": "https://github.com/JensenJ-Modding/MC-Server-Test/issues"
  },
  "license": "MIT License",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.mcservertest.fabric.MCServerTestFabric"
    ]
  },
  "mixins": [
    "mcservertest-common.mixins.json",
    "mcservertest-fabric.mixins.json"
  ],
  "depends": {
    "fabric": "*",
    "minecraft": ">=1.20.1"
  }
}